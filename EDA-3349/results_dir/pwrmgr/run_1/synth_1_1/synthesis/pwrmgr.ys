# Technology mapping
hierarchy -top pwrmgr



plugin -i synth-rs

synth_rs -post_cleanup 1 -legalize_ram_clk_ports -new_iobuf_map 3 -iofab_map 1 -tech genesis3 -de -goal delay   -effort high -carry auto  -keep_tribuf -new_dsp19x2 -new_tdp36k -max_lut 17472 -max_reg 34944 -max_device_dsp 56 -max_device_bram 56 -max_device_carry_length 336 -max_dsp 56 -max_bram 56 -max_carry_length 336  -fsm_encoding onehot   -de_max_threads -1     -init_registers 0 

write_verilog -noexpr -nodec -norename -v pwrmgr_post_synth.v
write_blif -param pwrmgr_post_synth.eblif

plugin -i design-edit
design_edit -tech genesis3 -sdc pin_location_pwrmgr.sdc -json config.json -w wrapper_pwrmgr_post_synth.v wrapper_pwrmgr_post_synth.eblif -pr post_pnr_wrapper_pwrmgr_post_synth.v post_pnr_wrapper_pwrmgr_post_synth.eblif
write_verilog -noexpr -nodec -norename -v fabric_pwrmgr_post_synth.v
write_blif -param fabric_pwrmgr_post_synth.eblif

  